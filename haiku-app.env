# haiku-app.env: what the beos-app-platforms release tools need to know about Envoi.
# Shell syntax: sourced by packaging/haiku/build-hpkg.sh and the release scripts
# (check-artifact.sh, release-gate.sh). Keep values quoted; no spaces around '='.

# ── Identity ──
APP_NAME="envoi"                       # the binary / team name (lowercase)
APP_CMD="envoi"                        # package name and command
APP_SIG="application/x-vnd.Envoi"      # = resource app_signature in the .rdef
RDEF="palemoon/app/haiku/Envoi.rdef.in"

# Haiku-family only: Envoi is a browser for Haiku and Renku OS, with a native Haiku
# interface. x86_64 for Haiku R1/beta6 (installs on Renku too); arm64 for Renku OS.
PLATFORMS="haiku"
APP_PATH="apps/Envoi/envoi"            # Gecko ships many files next to the binary
DESKBAR_NAME="Envoi"

# ── Version (Envoi's own; the .rdef's app_version matches it) ──
VERSION="0.1.0"
REVISION="1"

# ── Package metadata ──
SUMMARY="Envoi, a web browser for Haiku and Renku OS"
DESCRIPTION_FILE="packaging/haiku/description.txt"
HOMEPAGE="https://github.com/idumych/envoi"
GITHUB_REPO="idumych/envoi"
LICENSE_NAME="MPL v2.0"
COPYRIGHT="The Envoi contributors; Mozilla Foundation and contributors"
PACKAGER="The Envoi contributors"

# Runtime libraries beyond the Haiku API (HaikuPorts package names; from readelf -d of
# the built binaries; also in packaging/haiku/PackageInfo.in).
HPKG_REQUIRES_EXTRA="nspr nss libevent libffi fontconfig freetype zlib libiconv libjpeg_turbo"
DESKTOP_CATEGORIES="Network;WebBrowser;"
SMOKE_ARGS="about:blank"

# ── Build ── (mozconfig-haiku; ./mach build, make package, packaging/haiku/build-hpkg.sh)
HPKG_BUILD_DEPS="nspr_devel nss_devel libevent_devel libffi_devel fontconfig_devel freetype_devel zlib_devel libiconv_devel libjpeg_turbo_devel"
TEST_CMD=""                            # no host-side unit tests
TYPECHECK_SRCS=""                      # compiled in the VM, not type-checked on the host

# ── Feature test (release/test-plan.md) ──
FEATURE_CHECKS="page-load https form-input shortcuts download single-launch"
EVIDENCE_1="{p}-page-load.txt|Envoi test page {p}"
EVIDENCE_2="{p}-https.txt|Example Domain"
EVIDENCE_3="{p}-form.log|q=hello\+from\+{p}"
EVIDENCE_4="{p}-shortcuts.txt|PASS new-tab PASS close-tab PASS find"
EVIDENCE_5="{p}-download.txt|BEOS:TYPE.*application/zip"
EVIDENCE_6="{p}-single-launch.txt|teams=1"
