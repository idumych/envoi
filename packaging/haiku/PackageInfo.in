name			envoi
version			@VERSION@-@REVISION@
architecture		@ARCH@
summary			"Envoi, a web browser for Haiku and Renku OS"
description		"@DESCRIPTION@"
packager		"The Envoi contributors"
vendor			"The Envoi contributors"
copyrights		{
	"The Envoi contributors"
	"Mozilla Foundation and contributors"
}
licenses		{
	"MPL v2.0"
}
urls			{
	"https://github.com/idumych/envoi"
}

provides		{
	envoi = @VERSION@
	app:Envoi = @VERSION@
	cmd:envoi = @VERSION@
}

# Optional, dlopen()ed at run time (.hpkg has no "recommends"; noted in the
# description): mesa (WebGL), ffmpeg6/ffmpeg8 (H.264/AAC), myspell (spelling).
requires		{
	haiku >= r1~beta6
@REQUIRES@
}
