diff --git a/configure.in b/configure.in
index e4ddd33..6aad31f 100644
--- a/configure.in
+++ b/configure.in
@@ -815,6 +815,7 @@ if test -n "$CROSS_COMPILE"; then
         cygwin*)      OS_ARCH=WINNT ;;
         darwin*)      OS_ARCH=Darwin ;;
         riscos*)      OS_ARCH=RISCOS ;;
+        haiku*)       OS_ARCH=Haiku ;;
     esac
 else
     OS_ARCH=`uname -s | sed -e 's|/|_|g'`
@@ -1406,11 +1407,10 @@ tools are selected during the Xcode/Developer Tools installation.])
     USE_PTHREADS=1
     IMPL_STRATEGY=_PTH
     MDCPUCFG_H=_haiku.cfg
-    if test -n "$USE_64"; then
-        PR_MD_ASFILES=os_Linux_x86_64.s
-    else
-        PR_MD_ASFILES=os_Linux_x86.s
-    fi
+    case "$target_cpu" in
+    x86_64) PR_MD_ASFILES=os_Linux_x86_64.s ;;
+    i?86) PR_MD_ASFILES=os_Linux_x86.s ;;
+    esac
     PR_MD_CSRCS=linux.c
     MKSHLIB='$(CC) $(DSO_LDOPTS) -o $@'
     DSO_CFLAGS=-fPIC
